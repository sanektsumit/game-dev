{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate, max-age=0"
          }
        ]
      },
      {
        "source": "*.@(jpg|jpeg|gif|png|webp|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, s-maxage=86400"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, s-maxage=86400"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "*.md"
    ],
    "rewrites": [
      {
        "source": "/scorecard",
        "destination": "/scorecard.html"
      },
      {
        "source": "/result",
        "destination": "/scorecard.html"
      },
      {
        "source": "/organizer",
        "destination": "/organizer.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
